{
  "name": "zelllabor-11",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "check:spec": "node tools/check-spec.ts",
    "check:types": "tsc --noEmit",
    "check:catalog": "node tools/sync-task-catalog.ts --check",
    "generate:catalog": "node tools/sync-task-catalog.ts --write",
    "test": "npm run test:unit && npm run test:content && npm run test:build && playwright test",
    "test:unit": "vitest run tests/unit --outputFile=qa/generated/unit.json",
    "test:models": "vitest run tests/models",
    "test:content": "vitest run tests/content --outputFile=qa/generated/content.json",
    "test:review": "vitest run review",
    "test:build": "npm run build && vitest run tests/build --outputFile=qa/generated/build.json",
    "test:browser": "npm run build && playwright test",
    "build": "npm run check:types && npm run check:catalog && vite build && npm run check:publish",
    "check:publish": "node tools/check-publish.ts",
    "check": "npm run check:spec && npm run test",
    "test:legacy": "vitest run tests/legacy --outputFile=qa/generated/legacy.json",
    "report:naming": "node tools/report-naming.ts",
    "report:m602": "node tools/report-m602.ts",
    "report:m602-r1": "node tools/report-m602-r1.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
