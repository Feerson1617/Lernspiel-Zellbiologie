{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NamingOutcome naming-input/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "submission",
    "termResult",
    "assessedScope",
    "notAssessed",
    "pendingCriteria",
    "overallStatus",
    "unassessedRelevantText",
    "reasonCode",
    "feedback",
    "support"
  ],
  "properties": {
    "contractVersion": {
      "const": "naming-input/1.0.0"
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "target",
        "context",
        "attemptId",
        "revision",
        "predecessorId",
        "termText",
        "additionalStatements"
      ],
      "properties": {
        "contractVersion": {
          "const": "naming-input/1.0.0"
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "taskId",
                "fieldId"
              ],
              "properties": {
                "taskId": {
                  "const": "Z1.02"
                },
                "fieldId": {
                  "const": "term"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "taskId",
                "fieldId"
              ],
              "properties": {
                "taskId": {
                  "const": "M6.02"
                },
                "fieldId": {
                  "const": "process"
                }
              }
            }
          ]
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "taskId",
            "taskVersion",
            "rubricVersion",
            "contentVersion",
            "modelVersion",
            "instanceId",
            "seed",
            "phase",
            "material",
            "modelState",
            "contextHash"
          ],
          "properties": {
            "taskId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "taskVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "rubricVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "contentVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "modelVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "instanceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "seed": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "phase": {
              "enum": [
                "predict",
                "investigate",
                "explain",
                "transfer"
              ]
            },
            "material": {
              "type": "object"
            },
            "modelState": {
              "type": "object"
            },
            "contextHash": {
              "type": "string",
              "pattern": "^sha256-v1:[a-f0-9]{64}$"
            }
          }
        },
        "attemptId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "predecessorId": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "termText": {
          "type": "string"
        },
        "additionalStatements": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "termResult": {
      "title": "EvaluationResult",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "taskVersion",
        "rubricVersion",
        "contextHash",
        "status",
        "criteria",
        "unassessedRelevantText",
        "assistance",
        "feedbackCode"
      ],
      "properties": {
        "taskId": {
          "type": "string"
        },
        "taskVersion": {
          "type": "string"
        },
        "rubricVersion": {
          "type": "string"
        },
        "contextHash": {
          "type": "string"
        },
        "status": {
          "enum": [
            "correct",
            "incorrect",
            "partial",
            "clarify",
            "empty",
            "technical"
          ]
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "evidence",
              "reasonCode"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "correct",
                  "incorrect",
                  "partial",
                  "clarify",
                  "empty",
                  "technical"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "kind",
                    "value"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "input_span",
                        "option_id",
                        "state_value"
                      ]
                    },
                    "value": {
                      "type": "string"
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "reasonCode": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "incorrect"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "evidence": {
                      "minItems": 1
                    }
                  }
                }
              }
            ]
          }
        },
        "unassessedRelevantText": {
          "type": "boolean"
        },
        "assistance": {
          "enum": [
            "independent",
            "hint",
            "wordbank",
            "clarified",
            "solution_viewed"
          ]
        },
        "feedbackCode": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "correct"
              }
            }
          },
          "then": {
            "properties": {
              "unassessedRelevantText": {
                "const": false
              },
              "criteria": {
                "minItems": 1,
                "items": {
                  "properties": {
                    "status": {
                      "const": "correct"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "incorrect"
              }
            }
          },
          "then": {
            "properties": {
              "criteria": {
                "contains": {
                  "properties": {
                    "status": {
                      "const": "incorrect"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "assessedScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldId",
        "criterionId"
      ],
      "properties": {
        "fieldId": {
          "enum": [
            "term",
            "process"
          ]
        },
        "criterionId": {
          "enum": [
            "Z1.02.C01",
            "M6.02.C01"
          ]
        }
      }
    },
    "notAssessed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "index",
          "status",
          "value",
          "start",
          "end"
        ],
        "properties": {
          "field": {
            "enum": [
              "termText",
              "additionalStatements"
            ]
          },
          "index": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              }
            ]
          },
          "status": {
            "const": "not_assessed"
          },
          "value": {
            "type": "string"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "pendingCriteria": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "M6.02.C02",
          "M6.02.C03"
        ]
      }
    },
    "overallStatus": {
      "enum": [
        "correct",
        "incorrect",
        "partial",
        "clarify",
        "empty",
        "technical"
      ]
    },
    "unassessedRelevantText": {
      "type": "boolean"
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recognized",
        "difference",
        "next"
      ],
      "properties": {
        "recognized": {
          "type": "string",
          "minLength": 1
        },
        "difference": {
          "type": "string",
          "minLength": 1
        },
        "next": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assistance",
        "history",
        "origin",
        "events"
      ],
      "properties": {
        "assistance": {
          "enum": [
            "independent",
            "hint",
            "wordbank",
            "clarified",
            "solution_viewed"
          ]
        },
        "history": {
          "enum": [
            "verified",
            "history_unverified"
          ]
        },
        "origin": {
          "enum": [
            "typed",
            "wordbank_selection"
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "contextHash"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "kind": {
                "enum": [
                  "hint",
                  "wordbank",
                  "clarified",
                  "solution_viewed"
                ]
              },
              "contextHash": {
                "type": "string",
                "pattern": "^sha256-v1:[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
